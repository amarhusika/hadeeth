<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_coll"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/collShort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gold"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/collTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/title"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/collAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_soft"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/collProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_coll" />

    <TextView
        android:id="@+id/collCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="تصفّح وابحث ←"
        android:textColor="@color/green2"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
