<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- znak ح kao slika, da harf bude tačno u sredini (font ga u TextViewu pomjera) -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="حفظ السنة"
            android:src="@drawable/seal" />

        <TextView
            android:id="@+id/brandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="حِفْظُ السُّنَّةِ"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/navSahihayn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:text="الصحيحان"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/navZawaid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:text="الزوائد"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/gotoButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="انتقل إلى الحديث"
        android:padding="9dp"
        android:src="@drawable/ic_goto" />

    <TextView
        android:id="@+id/themeToggle"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="الوضع الليلي"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="☾"
        android:textColor="@color/ink"
        android:textSize="17sp" />
</LinearLayout>
